<?xml version='1.0' encoding='utf-8'?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="pb_3cs.net.xml.gz" />
        <route-files value="instance.rou.xml" />
		<additional-files value="charging_stations.add.xml" />
        <device.emissions.probability value="1.0" />
    </input>

    <output>
        <chargingstations-output value="chargingevents.xml" />
        <chargingstations-output.aggregated value="true" />
        <battery-output value="Battery.out.xml" />
    </output>

</configuration>